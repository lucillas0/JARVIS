venv/
.venv/

dist/
build/
dist-installer/
dist-temp*/

# Las ruedas de Python se descargan al compilar (ver build.yml). Son cientos
# de MB y son distintas para cada plataforma, asi que no van en el repo.
*.whl
**/dist-assets/wheelhouse/

*.exe
*.onnx

# rcedit si es necesario: sin el, el .exe de Windows sale sin icono
!JARVIS/app/scripts/rcedit-x64.exe

.env
__pycache__/
*.pyc

node_modules/

# El numero de WhatsApp del propietario. Es un dato personal y no va al repo:
# el puente lo lee de owner.json, que se crea la primera vez en el equipo.
# Si alguna vez llego a subirse, eso ya no se puede borrar del historico.
JARVIS/wa-bridge/owner.json

# El token con el que se abre el WebSocket al cerebro (ver brain/auth.py).
# NUNCA al repo: es la credencial que cierra el puerto a las demas paginas.
**/jarvis.token

# Bases de datos y cachés que crea el cerebro al arrancar. La de datos real
# va fuera de la instalación, pero en desarrollo cae aquí y no debe subirse.
**/db/*.json
**/db/*.db
**/db/qdrant/

# Carpetas de trabajo local, no forman parte del proyecto
_respaldo-ficheros-buenos/
_herramientas/
.freebuff/
