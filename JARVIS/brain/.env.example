# ------------------------------------------------------------------
# JARVIS — variables de entorno del brain (sección 12.4 de la spec)
# Rellena las API keys desde el asistente de primer arranque (app) o
# copiando este archivo a .env y editándolo a mano.
# ------------------------------------------------------------------

# --- Núcleo: claves pedidas en el primer arranque ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Integraciones opcionales (deja vacío si no las configuras) ---
GOOGLE_CALENDAR_CREDENTIALS_PATH=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
WEATHER_API_KEY=

# --- Fallback local (Ollama) ---
OLLAMA_HOST=http://localhost:11434
FALLBACK_MODEL=llama3.2:1b

# --- Riesgo y auditoría ---
AUDIT_LOG_RETENTION_DAYS=30
CONFIRMATION_TIMEOUT_SECONDS=30

# --- Contexto / memoria ---
CONTEXT_WINDOW_MESSAGES=15

# --- Voz ---
WAKE_WORD=jarvis
STT_MODEL=whisper-large-v3-turbo
TTS_VOICE=es_ES-davefx-medium
TTS_SPEED=1.0
CONVERSATION_SILENCE_SECONDS=2.5
MIC_SAMPLE_RATE=16000

# --- Visión ---
SCREEN_ANALYSIS_MODE=continuous   # continuous | on_demand | off
SCREEN_CAPTURE_INTERVAL_SECONDS=5

# --- Red del brain ---
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8000

# --- Model Router ---
GROQ_MODEL_FAST=llama-3.1-8b-instant
GEMINI_MODEL_HEAVY=gemini-2.0-flash
OPENROUTER_MODEL=openai/gpt-4o-mini