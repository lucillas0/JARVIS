    {"name": "campus_open",
     "risk_level": "medium",
     "requires_confirmation": False,
     "parameters": {},
     "description": "Abre o desbloquea la pÃ¡gina del ciclo (campus AVIESAU) en el navegador y mete el login (usuario y contraseÃ±a ya configurados).",
     "label": "Abriendo el campus",
     "handler": campus_open_handler},
]
