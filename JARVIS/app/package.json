{
  "name": "jarvis",
  "version": "4.1.0",
  "description": "JARVIS - Asistente personal de escritorio con voz para Windows, Linux y macOS",
  "main": "main.js",
  "author": "Lucas",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "iconos": "node scripts/generar-iconos.mjs ..",

    "dist": "npm run dist:win",
    "dist:win": "npm run iconos && electron-builder --win nsis --x64",

    "dist:linux": "npm run iconos && electron-builder --linux --x64",
    "dist:linux:arm": "npm run iconos && electron-builder --linux --arm64",

    "dist:mac": "npm run iconos && electron-builder --mac --x64",
    "dist:mac:arm": "npm run iconos && electron-builder --mac --arm64",

    "dist:linux:todo": "npm run iconos && electron-builder --linux AppImage deb rpm tar.gz --x64",
    "dist:mac:todo": "npm run iconos && electron-builder --mac dmg zip --x64 --arm64"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.jarvis.assistant",
    "productName": "JARVIS",
    "files": [
      "main.js",
      "jarvis-history.js",
      "notch-geometry.js",
      "preload.js",
      "overlay-backend.js",
      "ui/**/*",
      "splash/**/*",
      "setup-wizard/**/*"
    ],
    "extraResources": [
      {
        "from": "../brain",
        "to": "brain",
        "filter": [
          "**/*",
          "!venv/**",
          "!db/**",
          "!**/__pycache__/**",
          "!.env",
          "!.env.bak"
        ]
      },
      {
        "from": "../assets",
        "to": "assets"
      },
      {
        "from": "../wa-bridge",
        "to": "wa-bridge",
        "filter": [
          "**/*",
          "!session/**"
        ]
      }
    ],
    "directories": {
      "output": "../dist-installer"
    },
    "afterPack": "scripts/after-pack.js",
    "compression": "maximum",
    "win": {
      "extraResources": [
        {
          "from": "../dist-assets/wheelhouse",
          "to": "wheelhouse"
        }
      ],
      "target": [
        "nsis"
      ],
      "icon": "../assets/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "JARVIS-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "icon": "../assets/linux-icons",
      "category": "Utility",
      "synopsis": "Asistente personal de escritorio con voz",
      "description": "JARVIS es un asistente personal con voz. Habla, escucha y responde, y tiene una isla en la barra superior que se pliega sola.",
      "artifactName": "JARVIS-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "JARVIS",
          "Comment": "Asistente personal con voz",
          "Categories": "Utility;",
          "StartupWMClass": "JARVIS",
          "MimeType": "x-scheme-handler/jarvis;"
        }
      }
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "../assets/icon.icns",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "artifactName": "JARVIS-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "JARVIS necesita el microfono para oirte.",
        "NSCameraUsageDescription": "JARVIS usa la camara para verte.",
        "LSUIElement": false
      }
    },
    "dmg": {
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    }
  }
}
