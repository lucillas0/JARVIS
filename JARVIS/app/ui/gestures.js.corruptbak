        ctx.stroke();

        ctx.fillStyle = pinched ? '#8fc9e0' : 'rgba(93,166,204,0.7)';
        const pts = [[tx, ty], [ix, iy]];
        for (const [x, y] of pts) {
          ctx.beginPath();
          ctx.arc(x, y, pinched ? 5 : 3, 0, Math.PI * 2);
          ctx.fill();
        }
