      const wave3 = Math.pow(Math.max(0, Math.sin(t * 0.4)), 5);
      const wave4 = Math.pow(Math.max(0, Math.sin(t * 0.7 + 2)), 8);
      const fadeOut = Math.pow(Math.max(0, Math.sin(t * 0.25)), 3);
      const surge = wave3 * 1.5 + wave4 * 2.0 + boost;
