# =============================================================================
#  JARVIS · configuración del servidor
# =============================================================================
#  Copia este archivo a `.env` dentro de la carpeta del proyecto y rellénalo.
#  El instalador (instalar.sh) lo hace por ti la primera vez.
#
#  En Synology/Xenology, Container Manager lee este mismo `.env` cuando creas
#  el proyecto, así que no hay que repetir nada en la interfaz.
#
#  AVISO: este archivo contiene claves. No lo subas a ningún repositorio ni lo
#  compartas. Usa permisos restrictivos (chmod 600).
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Claves de modelos  —  hace falta al menos UNA para que JARVIS responda
# -----------------------------------------------------------------------------
# Las lee brain/config.py. Si las tres estan vacias el servidor arranca, pero no
# contesta: /health lo dira y lo veras en el registro de arranque.

# Groq — rapido y con generacion libre.
# https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — el mas capaz para tareas largas.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter — acceso a muchos modelos con una sola clave.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=


# -----------------------------------------------------------------------------
# 2. Modelos  —  cual usa cada tipo de tarea (valores por defecto del codigo)
# -----------------------------------------------------------------------------
# AI Gateway: la URL oficial de Groq y el modelo para cada tipo de tarea.
# (La clave ya esta mas arriba; no se repite aqui.)
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Dejados vacios a proposito: si no se ponen, valen los de Model Router.
GROQ_DEFAULT_MODEL=
GROQ_FAST_MODEL=
GROQ_REASONING_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_STREAM_ENABLED=1
GROQ_MODEL_FAST=openai/gpt-oss-120b
GROQ_MODEL_LIGHT=openai/gpt-oss-20b
GROQ_MODEL_VISION=openai/gpt-oss-120b
GEMINI_MODEL_HEAVY=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.6-flash
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
# Modelo con el que OpenCode programa tus proyectos (formato proveedor/modelo).
# Con la clave de Groq: gpt-oss-120b verificado; si algun dia falla, prueba
# con groq/openai/gpt-oss-20b (mas ligero).
OPENCODE_MODEL=groq/openai/gpt-oss-120b


# -----------------------------------------------------------------------------
# 3. Red del servidor
# -----------------------------------------------------------------------------
# Puerto en el host. Cambialo si en el NAS ya esta ocupado. Lo usan tanto el
# docker-compose.yml como instalar-nas.sh.
JARVIS_PUERTO=8000

# BRAIN_HOST debe ser 0.0.0.0 dentro del contenedor para que se pueda alcanzar
# desde fuera; si se deja en 127.0.0.1 solo se ve desde dentro.
BRAIN_HOST=0.0.0.0
BRAIN_PORT=8000


# -----------------------------------------------------------------------------
# 4. Contenedor  —  lo usan docker-compose.yml e instalar-nas.sh
# -----------------------------------------------------------------------------
# Usuario y grupo con los que corre el contenedor. En Synology pon los tuyos,
# o los ficheros de /data quedaran como root y no podras borrarlos desde DSM.
# El contenedor arranca como root y el entrypoint baja a este usuario solo, asi
# que tambien se encarga de dejar /data y /app/brain/db con su propietario.
PUID=1026
PGID=100

# Zona horaria: el resumen semanal y los horarios usan esta.
TZ=Europe/Madrid

# Limite de memoria del contenedor. 0 = sin limite. Un NAS con 1 GB de RAM, que
# es lo mas comun en Synology, conviene bajarlo: con "1g" va bien.
JARVIS_MEMORIA=2g

# Carpeta de datos en el host. La tiene que existir ANTES de arrancar:
# Synology no crea las carpetas de los bind mount y falla con
# "Bind mount failed" si no estan. El script instalar-nas.sh la crea por ti.
JARVIS_DATOS=./data


# -----------------------------------------------------------------------------
# 5. Memoria y contexto
# -----------------------------------------------------------------------------
# Cuantos mensajes recuerda de la conversacion.
CONTEXT_WINDOW_MESSAGES=15

# Dias que se guardan los registros de auditoria.
AUDIT_LOG_RETENTION_DAYS=30

# Segundos que espera una confirmacion antes de darse por rechazada.
CONFIRMATION_TIMEOUT_SECONDS=30


# -----------------------------------------------------------------------------
# 6. Integraciones  —  todas opcionales, dejalas vacias si no las usas
# -----------------------------------------------------------------------------
# Discord: ponte en un DM con el bot y escribe el prefijo para hablarle.
# El token es el del bot, no el tuyo.
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
DISCORD_PREFIX=

# Avisos al movil por ntfy.sh. Crea un tema y pon aqui su nombre.
NTIFY_TOPIC=

# Spotify (reproductor).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google Calendar: ruta al JSON de credenciales dentro del contenedor.
GOOGLE_CALENDAR_CREDENTIALS_PATH=

# Tiempo.
WEATHER_API_KEY=
WEATHER_UNIT=metric

# Analisis de virus de ficheros.
VIRUSTOTAL_API_KEY=


# -----------------------------------------------------------------------------
# 7. Fallback local  —  Ollama en otro equipo
# -----------------------------------------------------------------------------
# Si el servidor no tiene clave de ningun proveedor, usa esto.
# OJO: dentro de un contenedor, "localhost" es el propio contenedor. Para
# hablar con un Ollama del host usa la IP del host, no "localhost".
OLLAMA_HOST=http://172.17.0.1:11434
FALLBACK_MODEL=llama3.2:1b


# -----------------------------------------------------------------------------
# 8. Equipo remoto  —  JARVIS puede hablar por SSH con una Raspberry
# -----------------------------------------------------------------------------
RASPBERRY_HOST=lucillas.ddns.net
RASPBERRY_PORT=22
RASPBERRY_USER=
RASPBERRY_PASSWORD=

NEXTCLOUD_URL=https://lucillas.ddns.net/nextcloud
NEXTCLOUD_USER=
NEXTCLOUD_PASSWORD=


# -----------------------------------------------------------------------------
# 9. Campus  —  AVIESAU (opcional)
# -----------------------------------------------------------------------------
CAMPUS_URL=https://av.ciclosallerulloa.gal
CAMPUS_USER=
CAMPUS_PASSWORD=


# -----------------------------------------------------------------------------
# 10. Vm de escritorio (opcional)
# -----------------------------------------------------------------------------
VBOX_GUEST_USER=
VBOX_GUEST_PASSWORD=


# -----------------------------------------------------------------------------
# 12. Rutas internas  —  normalmente no hay que tocarlas
# -----------------------------------------------------------------------------
# Lo pone el docker-compose.yml. Si lo cambias, cambia tambien el volumen.
JARVIS_DATA_DIR=/data

# Audio de aviso. Por defecto buscalo en los assets del contenedor.
AUDIO_THEME_PATH=


# -----------------------------------------------------------------------------
# 11. Vision y voz
# -----------------------------------------------------------------------------
# En un NAS no hay pantalla ni micro: deja esto apagado para no cargar en balde.
#   off | on_demand | continuous
SCREEN_ANALYSIS_MODE=off
SCREEN_CAPTURE_INTERVAL_SECONDS=5

# La voz no se usa en el servidor; se deja aqui por si montas mas adelante.
WAKE_WORD=jarvis
STT_MODEL=whisper-large-v3-turbo
TTS_VOICE=es_ES-davefx-medium
TTS_SPEED=1.12
CONVERSATION_SILENCE_SECONDS=2.5
MIC_SAMPLE_RATE=16000
MIC_DEVICE=0

# ==============================================================================
#  MEMORIA PERSISTENTE · Mem0 OSS autoalojado
# ==============================================================================
#  JARVIS recuerda entre conversaciones. La memoria de siempre (SQLite +
#  Qdrant) sigue ahí y no se toca; esto es una capa más, que es la que sabe
#  hechos sobre usted: su NAS, cómo le gusta que hable, en qué trabaja.
#
#  Es un servicio aparte: "mem0" y "postgres", en este mismo proyecto. Los
#  recuerdos viven en el volumen mem0_postgres, y sobreviven a reiniciar
#  Docker, a recrear contenedores y a actualizar la imagen.
#
#  Todo va por la red interna del proyecto. Ni mem0 ni postgres se publican:
#  no se ven desde la LAN.
#
#  ---- Para empezar -------------------------------------------------------
#  1. Copie este fichero a .env:   cp configuracion.env.example .env
#  2. Ponga una contraseña de base de datos. Sin ella postgres NO arranca:
#     POSTGRES_PASSWORD=una-cosa-larga-y-que-no-sea-1234
#  3. Levante:  docker compose up -d
#  4. Compruebe:  curl -s http://localhost:PUERTO/health | grep -A4 memoria
#
#  ---- Para apagarla ------------------------------------------------------
#  MEMORY_ENABLED=0
#  JARVIS sigue contestando igual, con la memoria local de siempre.
#
#  ---- Apagarla sin borrar nada -------------------------------------------
#  MEMORY_ENABLED=0, o parar solo el servicio:
#  docker compose stop mem0 postgres
#  JARVIS contesta igual y avisa en /health de que la memoria no está.

# --- JARVIS (el cerebro) ---
# 0 = no usar memoria persistente. Lo normal es 1.
MEMORY_ENABLED=1
# Dirección del servicio. "mem0" es el nombre del servicio en este proyecto:
# no hace falta saber la IP ni publicarlo.
MEM0_URL=http://mem0:8888
# Clave del servicio. Con MEM0_AUTH_DISABLED=1 no hace falta y se deja vacío.
# Si algún día enciende la autenticación, se genera en el panel de mem0.
MEM0_API_KEY=
# Identificador de usuario. Con un solo JARVIS vale "default". El sistema
# está preparado para varios (user1, user2,...) sin tocar nada más.
MEMORY_USER_ID=default
# Cuántos recuerdos se le meten al modelo en cada respuesta. Más es más
# contexto y más latencia; menos es que a veces no se acuerda de nada.
MEMORY_MAX_RESULTS=5
# Cuánto espera el cerebro antes de volver a intentarlo si Mem0 está caído.
# Con 30, el primer fallo puede tardar MEMORY_TIMEOUT y los siguientes son
# instantáneos hasta que pase este rato.
MEMORY_RETRY_SECONDS=30
# Segundos de espera maxima en una llamada a Mem0. Es lo peor que puede
# retrasar una respuesta, así que no debería pasar de 4 o 5.
MEMORY_TIMEOUT=6
# Si usted dice "recuerda X", se guarda siempre. Con 0 se ignoraría, y eso
# sería justo lo que no quiere.
MEMORY_RESPETA_PETICION=1
# 1 = solo guarda lo que puede durar (preferencias, configuración,
# proyectos, nombres). Con 0 guarda cada conversación, y la memoria se
# llena de "hola" y "gracias" y deja de servir para nada.
MEMORY_SOLO_UTILES=1

# --- mem0 (el servicio de memoria) ---
# Mem0 necesita una LLM para decidir qué merece recordarse y un embedder para
# buscar. Por defecto usa OpenAI, que es de pago. Aquí va con Gemini, que es
# la clave que JARVIS ya tiene.
#
# OJO: el servidor NO lee MEM0_LLM_PROVIDER ni MEM0_EMBEDDER_PROVIDER, aunque
# aparezcan en sitios que lo digan. Comprobado en server/main.py. El proveedor
# sale de una fila en la tabla "settings" de postgres, y la escribe el script
# configurar-mem0.py que va en la imagen de mem0. Así que aquí solo hace falta
# darle la clave.
GEMINI_API_KEY=

# El embedder de Google NO lee GEMINI_API_KEY: lee GOOGLE_API_KEY. Si solo
# pones la de arriba, guardar funciona y buscar falla con un error de
# autenticación que no menciona ninguna de las dos. El compose ya copia la
# misma clave a las dos, así que esto se rellena solo si lo dejas vacío.
GOOGLE_API_KEY=

# Solo si tienes una de OpenAI y la quieres usar para mem0. Con esto vacía se
# sigue con Gemini. Si las tres claves están vacías, mem0 se queda con su
# proveedor por defecto y NO arranca.
OPENAI_API_KEY=

# Modelos de Gemini para mem0. La labor del LLM de mem0 es solo extraer
# hechos de un par de frases: no redacta ni conversa. Asi que vale uno
# pequeno y barato, y aqui importa mas que responda que lo bueno que sea.
#
# El defecto es gemini-flash-lite-latest porque es de los pocos que contestan
# con una clave gratuita. Medido con la clave del senor, uno por uno:
#     gemini-2.5-flash               404  no disponible para cuentas nuevas
#     gemini-2.0-flash               404  idem
#     gemini-3.6-flash               429  cuota agotada
#     gemini-3.5 / 3.7 / 3.8 flash   503  no disponible ahora
#     gemini-flash-latest            503  no disponible ahora
#     gemini-flash-lite-latest       OK
#     gemini-3-flash-preview         OK
#
# Si mem0 responde con un 502 al guardar, cambia esto por otro de los que
# responden. Los limites de Gemini van por modelo, no por cuenta: el mismo
# mismo modelo puede estar disponible para ti y no para el vecino. La labor del LLM de mem0 es solo extraer
# hechos de un par de frases, asi que vale uno pequeno y barato. El defecto es
# gemini-flash-lite-latest porque es de los pocos que responden con una clave
# gratuita: con la del senor, medido uno por uno,
#   gemini-2.5-flash   404 (no disponible para cuentas nuevas)
#   gemini-3.6-flash   429 (cuota agotada)
#   gemini-3.5/3.7/3.8 503 (no disponible ahora)
#   gemini-flash-lite-latest   OK
#   gemini-3-flash-preview     OK
# Si mem0 responde con un 502 al guardar, cambia esto por otro de los que
# responden. Los limites de Gemini van por modelo, no por cuenta.
MEM0_GEMINI_LLM=gemini-flash-lite-latest
MEM0_GEMINI_EMBEDDER=models/gemini-embedding-001
# DÉJALO VACÍO. Vacío significa "pregunta a postgres de cuántas dimensiones
# tiene la columna vector", y así se ajusta solo a lo que haya.
#
# Ponerle un número aquí estropea el arranque en silencio: el compose lo lee
# del .env y lo pasa al script, que entonces ni se molesta en preguntar. Y el
# error sale como un 502 sin explicar nada:
#     expected 1536 dimensions, not 768
# Solo hace falta rellenarlo si cambias de embedder y la columna no encaja.
MEM0_GEMINI_DIM=

# 1 = sin autenticación, porque mem0 no se publica. Solo para red de casa.
# Si lo expones, ponlo a 0 y genera un API key.
MEM0_AUTH_DISABLED=1
MEM0_ADMIN_API_KEY=
# Puerto para abrir el panel de mem0 a mano. Hay que descomentar el "ports"
# del docker-compose.yml; por defecto no se publica nada.
MEM0_PUERTO=8888

# --- postgres (donde viven los recuerdos) ---
# ESTE es el volumen que hay que respaldar. Ver la sección de backup.
POSTGRES_DB=mem0
POSTGRES_USER=mem0
# OBLIGATORIA. Sin esto postgres no arranca. Ponga una larga.
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=memories
MEM0_DB_MEMORIA=512m
