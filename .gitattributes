# Ficheros que deben viajar con finales de linea LF.
#
# Sin esto, core.autocrlf los convertiria a CRLF al hacer checkout y
# instalar.sh dejaria de arrancar en Linux: el shebang con \r da
# "bad interpreter: /usr/bin/env bash^M". En un NAS Synology esto rompe.

*.sh        text eol=lf
Dockerfile  text eol=lf
*.env       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Los .bat son de Windows y cmd.exe los quiere con CRLF. Ademas no pueden
# llevar BOM: se lo come la primera linea y "@echo off" deja de funcionar.
*.bat       text eol=crlf

# Documentacion y ficheros de texto normal.
*.md        text eol=lf
*.py        text eol=lf
*.json      text eol=lf
*.txt       text eol=lf

# Los ficheros de configuracion con secretos nunca se versionan.
.env        -text
.env.*      -text
keys.env    -text
